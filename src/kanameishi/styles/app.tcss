/* Kanameishi - Textual CSS スタイル */

Screen {
    background: #0b0b14;
    layout: vertical;
}

/* モーダル画面。背後のメイン画面を透過させるため、
   上の Screen ルール (不透明) をここで打ち消す */
AboutScreen, SettingsScreen {
    background: #0b0b14 60%;
}

/* ── ヘッダー ─────────────────── */
HeaderWidget {
    height: 2;
    background: #14141f;
    border-bottom: heavy #e51e28;
}

/* ── 緊急地震速報バナー (発表中のみ表示) ── */
#eew-banner {
    height: 1;
    display: none;
    background: #8c14a0;
    color: white;
    text-style: bold;
    padding: 0 2;
}

/* ── 津波警告バナー (発表中のみ表示) ── */
#tsunami-banner {
    height: 1;
    display: none;
    background: #e51e28;
    color: white;
    text-style: bold;
    padding: 0 2;
}

/* ── メインコンテンツ ────────── */
#main-content {
    layout: horizontal;
    height: 1fr;
    min-height: 16;
    margin: 0 1;
}

/* 左パネル: 地図 (地図45桁 + padding + 枠 + 縦スクロールバー1桁) */
#map-panel {
    width: 51;
    min-width: 40;
    border: round #2e2e48;
    background: #10101c;
    padding: 0 1;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    border-title-color: #8b8bb8;
    border-title-style: bold;
}

#map-legend {
    dock: bottom;
    height: 1;
    background: #16162a;
    padding: 0 1;
}

/* 右パネル: 情報 */
#info-panel {
    width: 1fr;
    min-width: 34;
    layout: vertical;
}

#eew-panel {
    display: none;
    height: auto;
    /* 「自分の地域」ブロック (3行) を出しても縦スクロールバーが出ない高さ。
       スクロールバーが出ると幅が1桁減って予報区の各行が折り返してしまう */
    max-height: 16;
    border: heavy #e51e28;
    background: #1a0d14;
    overflow-y: auto;
    border-title-color: #ff5a5a;
    border-title-style: bold;
}

#detail-panel {
    height: auto;
    min-height: 9;
    border: round #2e2e48;
    background: #10101c;
    border-title-color: #8b8bb8;
    border-title-style: bold;
}

#intensity-panel {
    height: 1fr;
    min-height: 7;
    border: round #2e2e48;
    background: #10101c;
    overflow-y: auto;
    border-title-color: #8b8bb8;
    border-title-style: bold;
}

#tsunami-panel {
    height: auto;
    min-height: 4;
    max-height: 10;
    border: round #2e2e48;
    background: #10101c;
    overflow-y: auto;
    border-title-color: #8b8bb8;
    border-title-style: bold;
}

/* ── 下部パネル: 履歴 ──────── */
#history-panel {
    height: auto;
    max-height: 13;
    min-height: 8;
    margin: 0 1;
    border: round #2e2e48;
    background: #10101c;
    border-title-color: #8b8bb8;
    border-title-style: bold;
}

QuakeTableWidget {
    background: #10101c;
}

QuakeTableWidget > .datatable--header {
    background: #1c1c2e;
    color: #a1a1c2;
    text-style: bold;
}

QuakeTableWidget > .datatable--cursor {
    background: #2d2d50;
    color: white;
    text-style: bold;
}

QuakeTableWidget > .datatable--even-row {
    background: #13131f;
}

QuakeTableWidget > .datatable--odd-row {
    background: #10101c;
}

/* ── ステータスバー ─────────── */
StatusBarWidget {
    background: #14141f;
    color: #8b8bb8;
}
