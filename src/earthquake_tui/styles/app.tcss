/* 強震モニタ TUI - Textual CSS スタイル */

Screen {
    background: rgb(12, 12, 20);
    layout: vertical;
}

/* ── ヘッダー ─────────────────── */
#app-header {
    dock: top;
    height: 3;
    background: rgb(25, 25, 35);
    color: white;
    text-align: center;
    padding: 1 0;
    text-style: bold;
    border-bottom: heavy rgb(200, 40, 40);
}

/* ── メインコンテンツ ────────── */
#main-content {
    layout: horizontal;
    height: 1fr;
    min-height: 16;
}

/* 左パネル: 地図 */
#map-panel {
    width: 1fr;
    min-width: 35;
    border: round rgb(50, 60, 90);
    background: rgb(15, 15, 25);
    padding: 0;
    overflow-y: auto;
}

#map-panel-title {
    dock: top;
    height: 1;
    padding: 0 1;
    background: rgb(30, 35, 55);
    color: rgb(120, 140, 200);
    text-style: bold;
}

/* 右パネル: 情報 */
#info-panel {
    width: 38;
    min-width: 32;
    max-width: 45;
    layout: vertical;
}

#detail-panel {
    height: auto;
    max-height: 12;
    border: round rgb(50, 60, 90);
    background: rgb(15, 15, 25);
}

#detail-panel-title {
    dock: top;
    height: 1;
    padding: 0 1;
    background: rgb(30, 35, 55);
    color: rgb(120, 140, 200);
    text-style: bold;
}

#intensity-panel {
    height: auto;
    max-height: 14;
    border: round rgb(50, 60, 90);
    background: rgb(15, 15, 25);
}

#intensity-panel-title {
    dock: top;
    height: 1;
    padding: 0 1;
    background: rgb(30, 35, 55);
    color: rgb(120, 140, 200);
    text-style: bold;
}

/* ── 下部パネル: 履歴 ──────── */
#history-panel {
    height: auto;
    max-height: 14;
    min-height: 6;
    border: round rgb(50, 60, 90);
    background: rgb(15, 15, 25);
}

#history-panel-title {
    dock: top;
    height: 1;
    padding: 0 1;
    background: rgb(30, 35, 55);
    color: rgb(120, 140, 200);
    text-style: bold;
}

QuakeTableWidget {
    background: rgb(15, 15, 25);
}

QuakeTableWidget > .datatable--header {
    background: rgb(30, 35, 55);
    color: rgb(180, 190, 220);
    text-style: bold;
}

QuakeTableWidget > .datatable--cursor {
    background: rgb(45, 50, 80);
    color: white;
    text-style: bold;
}

QuakeTableWidget > .datatable--even-row {
    background: rgb(18, 18, 30);
}

QuakeTableWidget > .datatable--odd-row {
    background: rgb(15, 15, 25);
}

/* ── ステータスバー ─────────── */
StatusBarWidget {
    background: rgb(20, 20, 32);
    color: rgb(140, 150, 180);
    border-top: heavy rgb(50, 60, 90);
}
